# MongoDB Connection String
# Replace this with your actual MongoDB URI
# Example: mongodb://localhost:27017/veridia or mongodb+srv://username:password@cluster.mongodb.net/veridia
MONGO_URI=mongodb://localhost:27017/veridia

# Server Port (optional, default is 5000)
PORT=5000

# Client URL for CORS (optional, default is http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Email Configuration (for sending emails)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# JWT Secret (optional, a random string for JWT tokens)
JWT_SECRET=your-secret-key-here
